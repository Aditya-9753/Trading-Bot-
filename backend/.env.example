# --- Database ---------------------------------------------------------------
# Development (default): SQLite file, tables auto-created on start
DATABASE_URL=sqlite:///./tradebot.db
# Production: MySQL 8 (run `alembic upgrade head` first)
# DATABASE_URL=mysql+pymysql://tradebot:CHANGE_ME@mysql:3306/tradebot?charset=utf8mb4

# --- Security ------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_to_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173

# --- Practice market -----------------------------------------------------------
ENABLE_SIMULATOR=true
TICK_SECONDS=1
TICKS_PER_BAR=30
SEED_DEMO=true
HISTORY_BARS=600
STARTING_CASH=1000000

# --- Bot sandbox limits --------------------------------------------------------
BOT_TIMEOUT_S=10
BOT_CPU_S=10
BOT_MEMORY_MB=1024
