.env.local
.env.*.local
*.pem
*.key

# Python / Virtualenv
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage & Linters
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
*.log
logs/

# Node / Frontend
frontend/node_modules/
node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# SQLite databases & logs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/*.db
backend/*.db-shm
backend/*.db-wal

# Docker volumes
mysql-data/

# OS / Editor files
.DS_Store
Thumbs.db
.idea/
