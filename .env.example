# Copy to .env and change every value before running `docker compose up`.
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
# at least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://localhost:8080
# set to false in a real deployment to skip the demo users and simulated instruments
SEED_DEMO=true
